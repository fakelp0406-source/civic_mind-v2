# CivicMind AI - local environment template (variable names only; no real values).
# Copy to .env (git-ignored) and fill in locally. Never commit secrets or paste them in chat.

# Runtime: development | testing | production
CIVICMIND_ENV=development
CIVICMIND_LOG_LEVEL=INFO

# Paths (relative to the project root)
CIVICMIND_DATA_DIR=data

# Response phrasing provider. Only "template" exists; LLM providers are a future option.
CIVICMIND_RESPONDER=template

# Future, optional: data.gov.in API key for per-resource APIs (leave empty).
# CIVICMIND_OGD_API_KEY=
